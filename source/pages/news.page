===JS===
SM.boot(function(){
  const {$, $$, esc, D, img, I} = SM, N = D.N;
  const L = N[0];
  $('#leadStory').innerHTML = `${SM.video(L.video, L.t, L.img)}<div class="tx"><span class="kicker">${esc(L.cat)} · ${esc(L.when)}</span><h2 class="h2" style="font-size:clamp(28px,3vw,46px)">${esc(L.t)}</h2><p class="muted">${esc(L.p)}</p></div>`;
  const cats = ['All'].concat([...new Set(N.map(n => n.cat))]);
  $('#chips').innerHTML = cats.map((c, i) => `<button type="button" aria-pressed="${!i}" data-c="${c}">${c}<span>${c === 'All' ? N.length : N.filter(n => n.cat === c).length}</span></button>`).join('');
  $('#ngrid').innerHTML = N.slice(1).map((n, i) => `<button class="nc rv d${i % 4}" data-id="${n.id}" data-c="${n.cat}" id="${n.id}" data-spot>${img(n.img, n.t)}<span class="nx"><span class="nm"><em>${esc(n.cat)}</em><span>${esc(n.when)}</span></span><b>${esc(n.t)}</b></span></button>`).join('');
  const cards = $$('#ngrid .nc');
  const filt = c => { let k = 0; cards.forEach(x => { const on = c === 'All' || x.dataset.c === c; x.classList.toggle('out', !on); if (on) { k++; x.classList.add('in'); } }); $('#ncount').textContent = `${k} stories`; };
  $('#chips').addEventListener('click', e => { const b = e.target.closest('button'); if (!b) return; $$('#chips button').forEach(x => x.setAttribute('aria-pressed', x === b)); filt(b.dataset.c); });
  filt('All');
  /* modal */
  const mdl = $('#mdl'), mc = $('#mdlC'); let last = null;
  const open = id => { const n = N.find(x => x.id === id); if (!n) return; last = document.activeElement;
    mc.innerHTML = `<div class="mi">${n.video ? SM.video(n.video, n.t, n.img) : img(n.img, n.t)}</div><div class="mx"><button class="ib x" aria-label="Close">${I.x}</button><span class="kicker">${esc(n.cat)} · ${esc(n.when)}</span><h2 class="h3" id="mdlT" style="font-size:clamp(22px,2.4vw,32px)">${esc(n.t)}</h2><p class="muted">${esc(n.p)}</p>
      ${n.gallery ? `<div class="mdl-g">${n.gallery.map((g, j) => `<button data-j="${j}" aria-label="Open photo ${j + 1}">${img(g, '')}</button>`).join('')}</div>` : ''}
      <div class="acts" style="margin-top:auto">${n.link ? `<a class="btn btn-primary btn-sm" href="${esc(n.link)}" target="_blank" rel="noopener" data-i="${/pdf$/i.test(n.link) ? 'doc' : 'ne'}">${esc(n.linkLabel || 'Read more')}</a>` : ''}<button class="btn btn-glass btn-sm" data-share data-i="share">Share</button></div></div>`;
    SM.enhanceButtons(mc); SM.wireImgs(mc); mdl.classList.add('open'); SM.lenis && SM.lenis.stop(); history.replaceState(null, '', '#' + id); setTimeout(() => $('.x', mc).focus(), 60);
    $('.x', mc).onclick = close; const g = $('.mdl-g', mc); if (g) g.onclick = e => { const b = e.target.closest('button'); if (b) SM.lightbox(n.gallery.map(x => ({ src: x.src, fb: x.fb, cap: n.t })), +b.dataset.j); };
    $('[data-share]', mc).onclick = async () => { try { if (navigator.share) await navigator.share({ title: n.t, url: location.href }); else SM.copy(location.href, 'Link copied'); } catch (e) { } }; };
  const close = () => { mdl.classList.remove('open'); SM.lenis && SM.lenis.start(); history.replaceState(null, '', location.pathname); last && last.focus && last.focus(); setTimeout(() => { if (!mdl.classList.contains('open')) mc.innerHTML = ''; }, 400); };
  mdl.addEventListener('click', e => { if (e.target === mdl) close(); });
  addEventListener('keydown', e => { if (e.key === 'Escape' && mdl.classList.contains('open') && !$('.vlb.open')) close(); });
  $('#ngrid').addEventListener('click', e => { const b = e.target.closest('.nc'); if (b) open(b.dataset.id); });
  const h = location.hash.slice(1); if (h && N.some(n => n.id === h)) setTimeout(() => open(h), 500);
});

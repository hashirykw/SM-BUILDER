@page: news
@title: News & updates · S. M. Builders & Developers
@desc: Construction milestones, partnerships, recognition and events from S. M. Builders & Developers: Burj Al Jinnah, S. M. House and S. M. Axis.
===CSS===
.nw-top { padding-top: calc(14px + var(--nav-h) + clamp(32px, 5vw, 70px)); }
.nw-head { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: var(--space-xl); align-items: end; margin-bottom: clamp(28px, 4vw, 48px); }
.nw-head .h1 { font-size: clamp(42px, 5.4vw, 86px); }
@media (max-width: 860px) { .nw-head { grid-template-columns: minmax(0, 1fr); } }
.lead-story { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 0; padding: 0; overflow: hidden; border-radius: var(--r-xl); margin-bottom: clamp(28px, 4vw, 48px); }
.lead-story .yt, .lead-story .yt.on { border-radius: 0; height: 100%; min-height: 340px; aspect-ratio: auto; border: 0; }
.lead-story .tx { padding: clamp(24px, 3.4vw, 48px); display: flex; flex-direction: column; gap: var(--space-md); justify-content: center; }
@media (max-width: 860px) { .lead-story { grid-template-columns: minmax(0, 1fr); } .lead-story .yt { min-height: 0; aspect-ratio: 16 / 9; } }
.nbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px; margin-bottom: 22px; }
.ngrid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
.ngrid .nc.out { display: none; }
@media (max-width: 1100px) { .ngrid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 760px) { .ngrid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } .nc b { font-size: 15px; } }
@media (max-width: 420px) { .ngrid { grid-template-columns: minmax(0, 1fr); } }
===HTML===
<section class="nw-top" data-shape="cloud" data-shape-s="1.2" data-shape-a=".35" data-shape-ma=".15">
  <div class="wrap">
    <nav class="crumbs rv" aria-label="Breadcrumb"><a href="index.html">Home</a><i></i><span>News &amp; updates</span></nav>

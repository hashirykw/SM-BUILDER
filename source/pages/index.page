    <div class="word" aria-hidden="true"><span>INTEGRITY</span></div>
    <div class="glow"></div>
    <div class="tower" id="heroTower" role="img" aria-label="S. M. Axis, Ground plus 22 floors, drawn from the architect's render"></div>
    <div class="ground"></div>
    <span class="cap-render">S. M. Axis · Ground + 22 · drawn from the architect's render · hover the tower to see its blueprint</span>
  </div>
  <div class="hero-ui wrap">
    <div class="hero-copy">
      <span class="kicker rv">S. M. Group · Since 1967</span>

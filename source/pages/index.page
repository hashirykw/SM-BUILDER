@page: index
@title: S. M. Builders & Developers · Renowned for its integrity since 1967, Karachi
@desc: S. M. Builders & Developers, part of S. M. Group since 1967: Burj Al Jinnah serviced apartments on Main Jinnah Avenue, S. M. House and S. M. Axis in North Nazimabad, Karachi.
===CSS===
/* ---------- intro: the page shows through "1967", then the camera dives through the 1 ---------- */
body[data-page="index"] .loader { display: none; }
.intro-bg { position: fixed; inset: 0; z-index: 209; background: linear-gradient(180deg, oklch(30% .06 80 / .15), oklch(20% .05 150 / .35)), url("images/ui/burj-dusk.jpg") center 40% / cover no-repeat, #0b1510; filter: saturate(1.15) brightness(1.15); transform: scale(1.15); }
.intro { position: fixed; inset: 0; z-index: 210; display: grid; place-items: center; align-content: center; gap: 1.6vw; background: #000; color: #fff; mix-blend-mode: multiply; will-change: transform; }
.intro .w { display: flex; overflow: hidden; padding: 0 .02em; font: 900 clamp(120px, 31vw, 520px)/.8 var(--font-display); font-stretch: 125%; letter-spacing: -.04em; }
.intro .w span { display: inline-block; transform: translateY(112%); }
.intro .s { font: 500 clamp(10px, 1.1vw, 14px)/1 var(--font-mono); letter-spacing: .4em; text-transform: uppercase; text-align: center; opacity: 0; }
.intro-meta { position: fixed; z-index: 211; bottom: calc(6vh + env(safe-area-inset-bottom, 0px)); pointer-events: none; color: var(--acc-text); }
.intro-meta.l { left: var(--gut); font: 800 clamp(30px, 4.5vw, 60px)/1 var(--font-display); font-stretch: 112%; font-variant-numeric: tabular-nums; }
.intro-meta.r { right: var(--gut); font: 500 11px/1.5 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; text-align: right; color: var(--ink-3); }
.intro-meta .ic { width: 64px; aspect-ratio: 340 / 184; margin-left: auto; margin-bottom: 10px; background: var(--logo-icon) center / contain no-repeat; filter: var(--logo-filter); }
body.intro-on .nav, body.intro-on .chat-btn { opacity: 0; }
.nav, .chat-btn { transition: opacity .8s var(--ease-out), transform var(--dur-3) var(--ease-out); }
@media (max-width: 600px) { .intro .w { font-size: 34vw; } .intro .s { letter-spacing: .2em; font-size: 9.5px; } }

/* ---------- hero ---------- */
.hero { position: relative; min-height: max(100svh, 740px); }
.hero-stage { position: absolute; inset: 0; --word-top: 14%; --th: 86%; --ta: .3333; --tx: 54%; }
.hero-ui { position: relative; z-index: 6; min-height: max(100svh, 740px); display: grid; grid-template-columns: minmax(0, 500px) minmax(0, 1fr) minmax(0, 340px); align-items: end; gap: var(--space-xl); padding-top: calc(var(--nav-h) + 40px); padding-bottom: clamp(28px, 4vw, 52px); pointer-events: none; }
.hero-ui > * { pointer-events: auto; }
.hero-copy .kicker { color: var(--acc-text); }
.hero-copy .h1 { font-size: clamp(38px, 4.3vw, 68px); }
.hero-copy .lead { margin-top: var(--space-lg); font-size: 16.5px; }
.onscreen { grid-column: 3; padding: 22px; border-radius: var(--r-lg); }
.onscreen ol { list-style: none; display: grid; gap: 4px; }
.onscreen li { position: relative; padding: 11px 14px 13px; border-radius: 14px; transition: background-color var(--dur-3) var(--ease-out), opacity var(--dur-3); opacity: .55; }
.onscreen li.on { background: var(--glass-2); opacity: 1; }
.onscreen li b { display: flex; justify-content: space-between; gap: 10px; font: 700 15px/1.2 var(--font-display); font-stretch: 110%; }
.onscreen li b small { font: 500 11px/1.4 var(--font-mono); color: var(--acc-text); white-space: nowrap; }
.onscreen li span { display: block; margin-top: 4px; font-size: 13.5px; color: var(--ink-2); line-height: 1.45; }
.onscreen li .pb { display: block; margin-top: 9px; height: 2px; border-radius: 2px; background: var(--stroke); overflow: hidden; }
.onscreen li .pb i { display: block; height: 100%; background: linear-gradient(90deg, var(--acc-lo), var(--acc-hi)); transform-origin: 0 50%; transform: scaleX(var(--p, 0)); }
.feat { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); margin-top: 12px; padding: 14px; border-radius: 16px; border: 1px solid var(--stroke); transition: border-color var(--dur-2), background-color var(--dur-2); }
.feat:hover { border-color: var(--stroke-3); background: var(--glass); }
.feat small { display: block; font-size: 12px; color: var(--ink-3); }
.feat b { display: block; font: 600 15px/1.25 var(--font-body); }
.feat svg { width: 18px; height: 18px; flex: none; transition: transform var(--dur-3) var(--ease-out); }
.feat:hover svg { transform: translateX(4px); }
.cap-render { position: absolute; z-index: 5; left: 54%; bottom: 14px; transform: translateX(-50%); font: 500 11px/1 var(--font-mono); letter-spacing: .08em; color: var(--ink-3); white-space: nowrap; }
.scroll-cue { position: absolute; z-index: 6; left: 50%; bottom: 18px; width: 22px; height: 36px; margin-left: -11px; border-radius: 12px; border: 1.5px solid var(--stroke-3); display: none; }
.scroll-cue::after { content: ""; position: absolute; left: 50%; top: 7px; width: 3px; height: 7px; margin-left: -1.5px; border-radius: 2px; background: var(--acc); animation: cue 1.8s var(--ease-in-out) infinite; }
@keyframes cue { 60% { transform: translateY(10px); opacity: 0; } 61% { transform: none; opacity: 0; } }
@media (max-width: 1180px) { .hero-ui { grid-template-columns: minmax(0, 430px) minmax(0, 1fr) minmax(0, 310px); } .hero-stage { --tx: 56%; --th: 78%; } }
@media (max-width: 1020px) {
  .hero { min-height: 0; }
  .hero-stage { position: relative; height: min(76svh, 640px); --th: 86%; --tx: 50%; --word-top: 20%; }
  .hero-ui { min-height: 0; grid-template-columns: minmax(0, 1fr); padding-top: 0; margin-top: -40px; }
  .onscreen { grid-column: auto; }
  .cap-render { bottom: 52px; font-size: 10px; white-space: normal; text-align: center; width: 90%; left: 50%; }
}
@media (max-width: 620px) { .cap-render { display: none; } .hero-stage { height: 70svh; } .acts .btn { flex: 1 1 auto; justify-content: space-between; } }

/* ---------- legacy numbers ---------- */
.legacy { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); padding: 8px; border-radius: var(--r-xl); }
.legacy > div { padding: clamp(18px, 2.4vw, 30px) clamp(14px, 1.8vw, 24px); border-right: 1px solid var(--stroke); min-width: 0; }
.legacy > div:last-child { border-right: 0; }
.legacy b { display: block; font: 800 clamp(34px, 4vw, 58px)/1 var(--font-display); font-stretch: 112%; letter-spacing: -.035em; font-variant-numeric: tabular-nums; }
.legacy b sup { font-size: .42em; vertical-align: top; color: var(--acc-text); margin-left: 2px; }
.legacy > div > span { display: block; margin-top: 10px; font-size: 13.5px; color: var(--ink-2); line-height: 1.4; }
.legacy b { white-space: nowrap; }
@media (max-width: 960px) { .legacy { grid-template-columns: repeat(2, minmax(0, 1fr)); } .legacy > div { border-right: 0; border-bottom: 1px solid var(--stroke); } .legacy > div:nth-child(odd) { border-right: 1px solid var(--stroke); } .legacy > div:last-child { grid-column: 1 / -1; border-bottom: 0; border-right: 0; } }

/* ---------- landmarks (sticky stack) ---------- */
.mth { display: grid; grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
.mth-l { position: sticky; top: 130px; }
.mth-l .lead { margin-top: var(--space-lg); }
.stack { display: grid; gap: 28px; }
.sc { position: sticky; top: calc(120px + var(--i) * 26px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: 470px; overflow: hidden; padding: 0; }
.sc .ph { height: 100%; min-height: 260px; border-radius: 0; }
.sc .tx { padding: clamp(24px, 3vw, 38px); display: flex; flex-direction: column; gap: var(--space-md); position: relative; z-index: 1; }
.sc .stp { display: flex; align-items: center; gap: 10px; font: 500 12px/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--acc-text); }
.sc .stp::after { content: ""; flex: 1; height: 1px; background: var(--stroke-2); }
.sc p { color: var(--ink-2); font-size: 15px; }
.sc dl { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 16px; margin-top: auto; padding-top: var(--space-md); border-top: 1px solid var(--stroke); }
.sc dl div { padding: 9px 0; border-bottom: 1px solid var(--stroke); }
.sc dt { font-size: 12px; color: var(--ink-3); }
.sc dd { font-weight: 600; font-size: 14px; }
@media (max-width: 1020px) { .mth { grid-template-columns: minmax(0, 1fr); } .mth-l { position: static; } }
@media (max-width: 760px) { .stack { --mcol: 88%; } .sc { position: relative; top: auto; grid-template-columns: minmax(0, 1fr); min-height: 0; } .sc .ph { height: 210px; } }

/* ---------- rise: S. M. Axis built floor by floor ---------- */
.rise { position: relative; height: 330vh; }
.rise-pin { position: sticky; top: 0; height: 100svh; overflow: hidden; }
.rise .stage { position: absolute; inset: 0; --word-top: 30%; --th: 84%; --ta: .3333; --tx: 50%; --tb: 2%; }
.rise .stage .word span { font-variant-numeric: tabular-nums; --word-a: oklch(100% 0 0 / .45); --word-b: oklch(100% 0 0 / 0); }
:root[data-theme="light"] .rise .stage .word span { --word-a: oklch(26% .06 156 / .4); --word-b: oklch(26% .06 156 / 0); }
.rise-ui { position: absolute; inset: 0; z-index: 5; pointer-events: none; }
.rise-ui > * { pointer-events: auto; }
.rise-head { position: absolute; left: var(--gut); top: calc(var(--nav-h) + 44px); max-width: 400px; }
.rise-head .lead { margin-top: var(--space-md); font-size: 16px; }
.rise-meter { position: absolute; right: var(--gut); top: calc(var(--nav-h) + 44px); width: 220px; padding: 18px; }
.rise-meter small { display: block; font-size: 12.5px; color: var(--ink-3); }
.rise-meter b { display: block; margin-top: 6px; font: 800 44px/1 var(--font-display); font-stretch: 112%; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
.rise-meter b span { font-size: 18px; color: var(--ink-3); font-weight: 600; }
.rise-meter .track { margin-top: 14px; height: 3px; border-radius: 3px; background: var(--stroke); overflow: hidden; }
.rise-meter .track i { display: block; height: 100%; background: linear-gradient(90deg, var(--acc-lo), var(--acc-hi)); transform-origin: 0 50%; transform: scaleX(var(--b, 0)); }
.callout { position: absolute; z-index: 6; display: flex; align-items: center; opacity: 0; transform: translateY(14px); transition: opacity var(--dur-3) var(--ease-out), transform var(--dur-3) var(--ease-out); }
.callout.on { opacity: 1; transform: translateY(-50%); }
.callout .ln { width: clamp(30px, 5vw, 80px); height: 1px; background: linear-gradient(90deg, var(--acc-hi), var(--stroke-3)); }
.callout .dt { width: 9px; height: 9px; border-radius: 50%; background: var(--acc-hi); box-shadow: 0 0 0 4px var(--acc-soft); flex: none; }
.callout .gc { padding: 12px 16px; border-radius: 14px; max-width: 250px; font-size: 13.5px; line-height: 1.4; color: var(--ink-2); }
.callout .gc b { display: block; font: 600 14.5px/1.3 var(--font-body); color: var(--ink); }
.callout.l { right: calc(50% + var(--tw, 140px)); }
.callout.r { left: calc(50% + var(--tw, 140px)); flex-direction: row-reverse; }
.callout.r .ln { background: linear-gradient(270deg, var(--acc-hi), var(--stroke-3)); }
.rise-cap { display: none; }
.rise-end { position: absolute; left: 50%; bottom: 34px; transform: translate(-50%, 16px); opacity: 0; transition: opacity var(--dur-3), transform var(--dur-3) var(--ease-out); }
.rise-end.on { opacity: 1; transform: translate(-50%, 0); }
@media (max-width: 860px) {
  .rise { height: 270vh; }
  .rise .stage { --th: 64%; --tb: 4%; --word-top: 32%; }
  .rise-head { right: var(--gut); max-width: none; } .rise-head .lead { display: none; }
  .rise-meter { top: calc(var(--nav-h) + 96px); right: auto; left: var(--gut); width: auto; padding: 10px 14px; display: flex; align-items: baseline; gap: 10px; }
  .rise-meter b { font-size: 26px; margin: 0; } .rise-meter .track { display: none; }
  .callout { display: none; }
  .rise-cap { display: block; position: absolute; left: var(--gut); right: var(--gut); bottom: 92px; padding: 12px 16px; border-radius: 16px; font-size: 13.5px; color: var(--ink-2); opacity: 0; transition: opacity var(--dur-3); }
  .rise-cap.on { opacity: 1; } .rise-cap b { display: block; font-weight: 600; font-size: 14.5px; color: var(--ink); }
  .rise-end { bottom: 24px; left: var(--gut); transform: translateY(16px); } .rise-end.on { transform: none; }
}

/* ---------- minutes from everything (time rings) ---------- */
.near { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(24px, 4vw, 64px); align-items: center; }
.rings { position: relative; aspect-ratio: 1; max-width: 560px; width: 100%; justify-self: center; }
.rings svg { width: 100%; height: 100%; overflow: visible; }
.rings .rg { fill: none; stroke: var(--stroke-2); stroke-dasharray: 2 5; }
.rings .rl { font: 500 10px var(--font-mono); fill: var(--ink-3); letter-spacing: .08em; }
.rings .sweep { transform-origin: 300px 300px; animation: sweep 9s linear infinite; }
@keyframes sweep { to { transform: rotate(360deg); } }
.rings .core { fill: var(--acc); }
.rings .dot { cursor: pointer; }
.rings .dot circle.d { fill: var(--bg); stroke: var(--acc); stroke-width: 2; transition: r var(--dur-2) var(--ease-out), fill var(--dur-2); }
.rings .dot text { font: 600 12px var(--font-body); fill: var(--ink-2); transition: fill var(--dur-2); }
.rings .dot.on circle.d { fill: var(--acc); r: 8; }
.rings .dot.on text { fill: var(--ink); }
.rings .spoke { stroke: var(--acc); stroke-width: 1; opacity: 0; transition: opacity var(--dur-2); }
.rings .dot.on .spoke { opacity: .7; }
.nlist { list-style: none; display: grid; }
.nlist li { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; padding: 13px 4px; border-bottom: 1px solid var(--stroke); cursor: default; transition: padding var(--dur-3) var(--ease-out), color var(--dur-2); }
.nlist li b { font: 600 16px/1.3 var(--font-body); }
.nlist li span { font: 500 13px/1 var(--font-mono); color: var(--acc-text); white-space: nowrap; }
.nlist li.on { padding-left: 14px; }
@media (max-width: 900px) { .near { grid-template-columns: minmax(0, 1fr); } .rings .dot text { display: none; } }

/* ---------- ring gallery ---------- */
.ring-sec { overflow: hidden; }
.ring-stage { position: relative; height: clamp(380px, 44vw, 540px); perspective: 1700px; perspective-origin: 50% 40%; touch-action: pan-y; cursor: grab; user-select: none; }
.ring-stage.drag { cursor: grabbing; }
.ring { position: absolute; left: 50%; top: 50%; width: 0; height: 0; transform-style: preserve-3d; transform: translateZ(calc(var(--R) * -1)) rotateX(-6deg) rotateY(var(--rot, 0deg)); }
.ri { position: absolute; width: var(--w); height: calc(var(--w) * 1.25); left: calc(var(--w) / -2); top: calc(var(--w) * -.625); border-radius: 18px; padding: 5px; transform: rotateY(var(--a)) translateZ(var(--R)); transition: opacity var(--dur-2), filter var(--dur-2); background: linear-gradient(155deg, var(--glass-3), var(--glass)); border: 1px solid var(--stroke-2); box-shadow: var(--shadow-s); -webkit-backface-visibility: hidden; backface-visibility: hidden; }
.ri .ph { width: 100%; height: 100%; border-radius: 13px; }
.ri:hover { filter: brightness(1.08); }
.ring-floor { position: absolute; left: 10%; right: 10%; bottom: 4%; height: 26%; background: radial-gradient(50% 50% at 50% 50%, var(--acc-soft), transparent 70%); filter: blur(20px); pointer-events: none; }
.ring-cap { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-md) var(--space-lg); margin-top: var(--space-lg); }
.ring-cap .now { min-width: 0; text-align: center; min-width: 180px; }
.ring-cap .now b { display: block; font: 700 18px/1.2 var(--font-display); font-stretch: 110%; }
.ring-cap .now small { color: var(--ink-3); font-size: 13px; }

/* ---------- built with + affiliations ---------- */
.aff { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 10px; }
@media (max-width: 1100px) { .aff { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
@media (max-width: 520px) { .aff { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

/* ---------- news rail ---------- */
#newsRail { --col: clamp(250px, 23vw, 310px); }

/* ---------- enquiry ---------- */
.enq { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); overflow: hidden; padding: 0; border-radius: var(--r-xl); }
.enq-l { position: relative; padding: clamp(28px, 4vw, 56px); display: flex; flex-direction: column; gap: var(--space-lg); overflow: hidden; }
.enq-l::after { inset: 12px; }
.enq-l .lines { display: grid; gap: 2px; margin-top: auto; position: relative; z-index: 1; }
.enq-l .lines a { display: flex; justify-content: space-between; align-items: center; gap: var(--space-md); padding: 13px 0; border-bottom: 1px solid oklch(80% .1 82 / .22); font-weight: 500; transition: color var(--dur-2); }
.enq-l .lines a span { color: oklch(95% .02 90 / .6); font-weight: 400; font-size: 14px; }
.enq-l .lines a:hover { color: oklch(84% .1 84); }
.enq-l .bgl { position: absolute; right: -8%; bottom: -10%; width: 70%; aspect-ratio: 340 / 184; background: var(--logo-icon) center / contain no-repeat; opacity: .1; pointer-events: none; }
.enq-r { padding: clamp(28px, 4vw, 56px); display: grid; gap: var(--space-lg); align-content: start; }
@media (max-width: 900px) { .enq { grid-template-columns: minmax(0, 1fr); } }
===HTML===
<div class="intro-bg" id="introBg" aria-hidden="true" hidden></div>
<div class="intro" id="intro" aria-hidden="true" hidden><div class="w">1967</div><div class="s">S. M. Group · Renowned for its integrity</div></div>
<div class="intro-meta l" id="introL" aria-hidden="true" hidden>000</div>
<div class="intro-meta r" id="introR" aria-hidden="true" hidden><div class="ic"></div>S. M. Builders<br>&amp; Developers</div>

<section class="hero" data-shape="cloud" data-shape-s="1.3" data-shape-a=".45" data-shape-ma=".3" data-shape-spin=".03" aria-labelledby="heroTitle">

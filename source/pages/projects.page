===JS===
SM.boot(function(){
  const {$, $$, esc, D, img, I} = SM, P = D.P;
  $('#ptower').innerHTML = SM.towerSVG('bp', 't-bp') + SM.towerSVG('real', 't-real') + '<span class="t-scan" aria-hidden="true"></span>' + SM.towerSVG('bp', 't-xray');
  SM.stage($('#pstage'), { dur: 3400, delay: 350, fit: .92, max: 300 });
  const tags = p => [p.kind, p.stage === 'ready' ? 'ready' : '', p.stage === 'launch' || p.stage === 'build' ? 'open' : ''].filter(Boolean);
  $('#rows').innerHTML = P.map(p => `<article class="prow glass rv" data-t="${tags(p).join(' ')}" data-spot>
    <a class="pimg" href="project.html?p=${p.s}" aria-label="Open ${esc(p.n)}">${img(p.cover, p.n)}<span class="no">${p.no}</span><span class="cnt">${p.pics.length} photos · ${p.plans.length} plans</span></a>
    <div class="ptx"><span class="pill ${p.stage}">${esc(p.status)}</span><h2 class="h2">${esc(p.n)}</h2><span class="tg">${esc(p.tagline)}</span><p>${esc(p.sum)}</p>
    <ul><li><span>Location</span><b>${esc(p.area)}</b></li><li><span>Building</span><b>${esc(p.building)}</b></li><li><span>${p.kind === 'com' ? 'Spaces' : 'Homes'}</span><b>${esc(p.units)}</b></li>${p.facts.filter(f => f[0] === 'Payment').map(f => `<li><span>Payment</span><b>${esc(f[1])}</b></li>`).join('')}</ul>
    <div class="acts"><a class="btn btn-primary" href="project.html?p=${p.s}" data-i="arrow">Explore</a><a class="btn btn-glass" href="floor-plans.html#${p.s}" data-i="plan">Floor plans</a></div></div></article>`).join('');
  const rows = $$('.prow'), cnt = $('#fcount');
  const apply = f => { let n = 0; rows.forEach(r => { const on = f === 'all' || r.dataset.t.split(' ').includes(f); r.classList.toggle('out', !on); if (on) { n++; r.classList.add('in'); } }); cnt.textContent = `${n} of ${rows.length} projects`; };
  $('#chips').addEventListener('click', e => { const b = e.target.closest('button'); if (!b) return; $$('#chips button').forEach(x => x.setAttribute('aria-pressed', x === b)); apply(b.dataset.f); });
  apply('all');
  const ROWS = [
    ['Type', p => p.kindLabel], ['Location', p => p.loc], ['Building', p => p.building], [p => 'Units', p => p.units],
    ['Sizes', p => p.s === 'burj-al-jinnah' ? '1,765 to 2,691 sq ft gross' : p.s === 'sm-axis' ? '1,072 to 1,597 sq ft net' : 'Halls, showrooms, clinics & restaurants'],
    ['Payment', p => p.pay.type === 'plan' ? `${p.pay.down}% down, ${p.pay.months} monthly` : p.pay.type === 'rates' ? `${p.pay.down}% down, ${p.pay.inst}% in ${p.pay.months} months, ${p.pay.poss}% on possession` : 'Ask sales'],
    ['Price', p => p.pay.type === 'rates' ? 'From Rs 38,000 per sq ft (gross)' : 'On request'],
    ['Status', p => p.status], ['Highlights', p => p.a.slice(0, 4).join(', ')]
  ];
  $('#cmp').innerHTML = `<thead><tr><th scope="col"><span class="sr">Detail</span></th>${P.map(p => `<th scope="col">${esc(p.n)}<small>${esc(p.area)}</small></th>`).join('')}</tr></thead><tbody>${ROWS.map(r => `<tr><th scope="row">${typeof r[0] === 'function' ? 'Units' : r[0]}</th>${P.map(p => `<td>${esc(r[1](p))}</td>`).join('')}</tr>`).join('')}<tr><th scope="row"></th>${P.map(p => `<td><a href="project.html?p=${p.s}">Open ${esc(p.n)} →</a></td>`).join('')}</tr></tbody>`;
});

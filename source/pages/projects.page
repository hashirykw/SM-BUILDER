@page: projects
@title: Projects · S. M. Builders & Developers, Karachi
@desc: Burj Al Jinnah serviced apartments on Main Jinnah Avenue, S. M. House commercial at Main 5 Star and S. M. Axis apartments on Sher Shah Suri Road, North Nazimabad. Compare all three.
===CSS===
.phero .stage { --word-top: 24%; }
.prow { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 0; overflow: hidden; padding: 0; border-radius: var(--r-xl); transition: opacity var(--dur-3), transform var(--dur-3) var(--ease-out); }
.prow + .prow { margin-top: clamp(20px, 3vw, 36px); }
.prow:nth-child(even) { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); }
.prow:nth-child(even) .pimg { order: 2; }
.prow.out { display: none; }
.pimg { position: relative; min-height: clamp(320px, 38vw, 540px); display: block; overflow: hidden; }
.pimg .ph { position: absolute; inset: 0; }
.pimg .ph img { transition: opacity var(--dur-3), transform 1.6s var(--ease-out); }
.pimg:hover .ph img { transform: scale(1.04); }
.pimg .no { position: absolute; z-index: 2; left: 22px; top: 18px; font: 800 clamp(60px, 8vw, 120px)/1 var(--font-display); font-stretch: 120%; letter-spacing: -.05em; color: oklch(100% 0 0 / .9); text-shadow: 0 10px 40px oklch(0% 0 0 / .5); }
.pimg .cnt { position: absolute; z-index: 2; right: 16px; bottom: 16px; padding: 8px 12px; border-radius: 12px; font: 500 11px/1 var(--font-mono); letter-spacing: .08em; color: #fff; background: oklch(15% .02 158 / .5); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
.ptx { padding: clamp(24px, 3.4vw, 48px); display: flex; flex-direction: column; gap: var(--space-md); }
.ptx .h2 { font-size: clamp(32px, 3.6vw, 54px); }
.ptx .tg { font: 400 italic clamp(19px, 1.6vw, 24px)/1.25 var(--font-serif); color: var(--acc-text); }
.ptx p { color: var(--ink-2); }
.ptx ul { list-style: none; display: grid; gap: 0; margin-top: var(--space-sm); border-top: 1px solid var(--stroke); }
.ptx li { display: flex; justify-content: space-between; gap: 14px; padding: 11px 0; border-bottom: 1px solid var(--stroke); font-size: 14.5px; }
.ptx li span { color: var(--ink-3); }
.ptx li b { font-weight: 600; text-align: right; }
.ptx .acts { margin-top: auto; padding-top: var(--space-md); }
@media (max-width: 900px) { .prow, .prow:nth-child(even) { grid-template-columns: minmax(0, 1fr); } .prow:nth-child(even) .pimg { order: 0; } .pimg { min-height: 280px; } }
.fbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px; margin-bottom: clamp(24px, 3vw, 40px); }
.fbar .muted { font-size: 14px; }
/* compare table */
.cmpw { padding: 8px; border-radius: var(--r-xl); overflow: hidden; }
.cmp { width: 100%; border-collapse: collapse; min-width: 720px; }
.cmpx { overflow-x: auto; border-radius: calc(var(--r-xl) - 8px); }
.cmp th, .cmp td { padding: 16px 18px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--stroke); font-size: 14.5px; }
.cmp thead th { font: 700 18px/1.2 var(--font-display); font-stretch: 108%; background: var(--glass); }
.cmp thead th small { display: block; margin-top: 6px; font: 500 11px/1.3 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--acc-text); }
.cmp tbody th { font-weight: 500; color: var(--ink-3); width: 18%; font-size: 13.5px; }
.cmp tr:last-child td, .cmp tr:last-child th { border-bottom: 0; }
.cmp td a { color: var(--acc-text); font-weight: 600; }

===JS===
SM.boot(function(){
  const {$, $$, esc, D, I, img, wa} = SM, P = D.P;
  const slug = new URLSearchParams(location.search).get('p') || (location.hash.slice(1)), p = P.find(x => x.s === slug), i0 = P.indexOf(p);
  if (!p) {
    $('#pv').innerHTML = `<div class="nf glass"><h1 class="h2">Project not <span class="accent">found.</span></h1><p class="lead" style="margin:16px auto 0">That link may be out of date. See all our projects instead.</p><div class="acts" style="justify-content:center"><a class="btn btn-primary" href="projects.html" data-i="arrow">See all projects</a></div></div>`;
    return;
  }
  document.title = `${p.n} · S. M. Builders & Developers, Karachi`;
  const md = $('meta[name="description"]'); if (md) md.content = p.d.slice(0, 158);
  const msg = `Hi S. M. Builders, I'm interested in ${p.n}. Please share availability, the price list and the payment plan.`;
  const tall = x => /360-image|Rull-up|Payment-Plan/.test(x.src);
  $('#pv').innerHTML = `
    <nav class="crumbs rv" aria-label="Breadcrumb"><a href="index.html">Home</a><i></i><a href="projects.html">Projects</a><i></i><span>${esc(p.n)}</span></nav>
    <div class="pv-grid">
      <div class="rv">
        <div class="frame glass" data-spot>
          <div class="main${tall(p.pics[0]) ? ' tall' : ''}" id="main" role="button" tabindex="0" aria-label="Open photo viewer">${img(p.pics[0], p.pics[0].cap || p.n, '', true)}<span class="cap" id="mcap">${esc(p.pics[0].cap || p.n)}</span><button class="ib zoom" id="zoom" aria-label="View all ${p.pics.length} photos full screen">${I.expand}</button></div>
          ${p.pics.length > 1 ? `<div class="thumbs" id="thumbs">${p.pics.map((x, j) => `<button aria-label="Show photo ${j + 1}: ${esc(x.cap || '')}" aria-current="${!j}" data-j="${j}">${img(x, '')}</button>`).join('')}</div>` : ''}
        </div>
      </div>
      <aside class="info-p glass rv d1" data-spot>
        <span class="pill ${p.stage}">${esc(p.status)}</span>
        <h1 class="h1 split">${esc(p.n)}</h1>
        <span class="tg">${esc(p.tagline)}</span>
        <p class="loc">${I.pin}<span>${esc(p.loc)}</span></p>
        <dl class="facts">${p.facts.map(f => `<div><dt>${f[0]}</dt><dd>${esc(f[1])}</dd></div>`).join('')}</dl>
        <div class="acts"><a class="btn btn-primary" href="#enq" data-i="arrow">Get the price list</a><a class="ib" href="tel:+923111756111" aria-label="Call S. M. Builders">${I.phone}</a><a class="ib" href="${wa(msg)}" target="_blank" rel="noopener" aria-label="Message sales on WhatsApp">${I.wa}</a><button class="ib" id="share" aria-label="Share this project">${I.share}</button></div>
      </aside>
    </div>`;

  const S = [];  /* jump-nav sections */
  const sec = (id, label, html, shape = '') => { S.push([id, label]); return `<section class="sec tight" id="${id}" ${shape}>${html}</section>`; };
  let H = '';
  H += sec('overview', 'Overview', `<div class="wrap ov">
      <div><span class="kicker">${esc(p.kindLabel)}</span><h2 class="h2 split" style="font-size:clamp(30px,3.6vw,52px)">About <span class="accent">${esc(p.n)}.</span></h2><p class="big rv d1">${esc(p.d)}</p></div>
      <div class="hl gframe rv d2"><h3 class="h3">What sets it apart</h3><ul>${p.hl.map(a => `<li>${I.check}<span>${esc(a)}</span></li>`).join('')}</ul></div>
    </div>`, 'data-shape="plan" data-shape-x="-.55" data-shape-y=".1" data-shape-s=".6" data-shape-a=".25" data-shape-ma=".1"');
  H += sec('amenities', 'Amenities', `<div class="wrap"><div class="rel-h"><h2 class="h2 split" style="font-size:clamp(30px,3.6vw,52px)">Amenities &amp; <span class="accent">features.</span></h2><span class="muted">${p.a.length} listed by S. M. Builders</span></div>
      <div class="am">${p.a.map((a, j) => `<div class="rv d${j % 4}"><i>${String(j + 1).padStart(2, '0')}</i><span>${esc(a)}</span></div>`).join('')}</div>
      ${p.materials ? `<h3 class="h3" style="margin-top:clamp(36px,5vw,64px)">Top shelf materials</h3><div class="mats">${p.materials.map(m => `<div class="glass rv" data-spot><b>${esc(m[0])}</b><small>${esc(m[1])}</small></div>`).join('')}</div>` : ''}
      ${p.uses ? `<h3 class="h3" style="margin-top:clamp(36px,5vw,64px);margin-bottom:16px">Floor by floor</h3><div class="uses mrail">${p.uses.map((u, j) => `<div class="glass rv d${j}" data-spot><em>0${j + 1}</em><span><b>${esc(u[0])}</b><br><span>${esc(u[1])}</span></span></div>`).join('')}</div>` : ''}

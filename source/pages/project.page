@page: project
@title: Project · S. M. Builders & Developers, Karachi
@desc: Photos, floor plans, payment plan, amenities and location for S. M. Builders & Developers projects in Karachi.
===CSS===
.pv { padding-top: calc(14px + var(--nav-h) + clamp(28px, 4vw, 56px)); }
.pv-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, .9fr); gap: clamp(20px, 3vw, 44px); align-items: start; }
.frame { padding: 8px; border-radius: var(--r-xl); }
.frame .main { position: relative; border-radius: calc(var(--r-xl) - 8px); overflow: hidden; aspect-ratio: 16 / 11; cursor: zoom-in; background: var(--bg-2); }
.frame .main .ph { position: absolute; inset: 0; }
.frame .main .ph img { transition: opacity var(--dur-3), transform 1.6s var(--ease-out); }
.frame .main:hover .ph img { transform: scale(1.03); }
.frame .main.tall .ph img { object-fit: contain; }
.frame .zoom { position: absolute; right: 14px; bottom: 14px; z-index: 2; color: oklch(98% 0 0); background: oklch(15% .02 158 / .4); border-color: oklch(100% 0 0 / .2); }
.frame .cap { position: absolute; left: 14px; bottom: 14px; z-index: 2; max-width: calc(100% - 90px); padding: 8px 12px; border-radius: 10px; font-size: 13px; color: #fff; background: oklch(15% .02 158 / .45); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
.thumbs { display: flex; gap: 8px; overflow-x: auto; padding: 10px 2px 2px; scrollbar-width: none; }
.thumbs::-webkit-scrollbar { display: none; }
.thumbs button { flex: none; width: 92px; height: 66px; border-radius: 12px; overflow: hidden; opacity: .5; border: 2px solid transparent; transition: opacity var(--dur-2), border-color var(--dur-2); }
.thumbs button:hover { opacity: .85; }
.thumbs button[aria-current="true"] { opacity: 1; border-color: var(--acc-hi); }
.thumbs .ph { width: 100%; height: 100%; }
.info-p { padding: clamp(22px, 3vw, 36px); border-radius: var(--r-xl); position: sticky; top: calc(14px + var(--nav-h) + 20px); }
.info-p .h1 { font-size: clamp(36px, 4vw, 62px); margin-top: 14px; }
.info-p .tg { display: block; margin-top: 10px; font: 400 italic clamp(19px, 1.6vw, 24px)/1.25 var(--font-serif); color: var(--acc-text); }
.info-p .loc { display: flex; gap: 8px; align-items: flex-start; margin-top: var(--space-md); color: var(--ink-2); font-size: 15px; }
.info-p .loc svg { width: 18px; height: 18px; color: var(--acc-text); flex: none; margin-top: 3px; }
.facts { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); margin-top: var(--space-xl); border-top: 1px solid var(--stroke); }
.facts div { padding: 15px 0; border-bottom: 1px solid var(--stroke); }
.facts div:nth-child(odd) { padding-right: 14px; } .facts div:nth-child(even) { padding-left: 14px; border-left: 1px solid var(--stroke); }
.facts dt { font-size: 12.5px; color: var(--ink-3); }
.facts dd { margin-top: 4px; font: 600 15.5px/1.3 var(--font-body); }
.info-p .acts { margin-top: var(--space-xl); display: grid; grid-template-columns: minmax(0, 1fr) auto auto auto; gap: 8px; align-items: center; }
.info-p .acts .btn { justify-self: stretch; justify-content: space-between; }
.info-p .acts .ib { width: 54px; height: 54px; }
@media (max-width: 420px) { .info-p .acts { grid-template-columns: repeat(3, minmax(0, 1fr)); } .info-p .acts .btn { grid-column: 1 / -1; } .info-p .acts .ib { width: 100%; border-radius: 16px; } }
@media (max-width: 1020px) { .pv-grid { grid-template-columns: minmax(0, 1fr); } .info-p { position: static; } }
/* jump nav */
.jn { position: sticky; top: calc(14px + var(--nav-h) + 10px); z-index: 50; margin-top: clamp(28px, 4vw, 48px); display: flex; gap: 4px; overflow-x: auto; padding: 5px; border-radius: var(--r-pill); scrollbar-width: none; width: max-content; max-width: 100%; transition: top var(--dur-3) var(--ease-out); }
body.nav-hidden .jn { top: 12px; }
.jn::-webkit-scrollbar { display: none; }
.jn a { flex: none; padding: 9px 15px; border-radius: var(--r-pill); font-size: 13.5px; color: var(--ink-2); transition: background-color var(--dur-2), color var(--dur-2); white-space: nowrap; }
.jn a:hover { color: var(--ink); } .jn a.on { background: var(--btn-ink); color: var(--btn-on-ink); }
/* overview */
.ov { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
.ov .big { font-size: clamp(18px, 1.5vw, 21px); line-height: 1.65; color: var(--ink-2); margin-top: var(--space-lg); }
.hl { padding: clamp(22px, 3vw, 36px); }
.hl ul { list-style: none; display: grid; gap: 0; margin-top: var(--space-md); position: relative; z-index: 1; }
.hl li { display: flex; gap: 12px; align-items: flex-start; padding: 11px 0; border-bottom: 1px solid oklch(80% .1 82 / .2); font-size: 15px; }
.hl li:last-child { border-bottom: 0; }
.hl li svg { width: 17px; height: 17px; color: oklch(84% .1 84); flex: none; margin-top: 3px; }
.hl h3 { position: relative; z-index: 1; }
@media (max-width: 900px) { .ov { grid-template-columns: minmax(0, 1fr); } }
/* amenities */
.am { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
.am div { display: flex; gap: 12px; align-items: center; padding: 16px; border-radius: 16px; background: var(--glass); border: 1px solid var(--stroke); font-size: 14.5px; font-weight: 500; transition: border-color var(--dur-2), transform var(--dur-3) var(--ease-out); }
.am div:hover { border-color: var(--stroke-3); transform: translateY(-2px); }
.am i { width: 28px; height: 28px; border-radius: 50%; flex: none; display: grid; place-items: center; background: var(--acc-soft); color: var(--acc-text); font: 600 11px/1 var(--font-mono); font-style: normal; }
@media (max-width: 1000px) { .am { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 480px) { .am { grid-template-columns: minmax(0, 1fr); } }
.mats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-top: var(--space-xl); }
.mats div { padding: 18px; border-radius: 16px; }
.mats b { display: block; font: 700 16px/1.2 var(--font-display); font-stretch: 108%; }
.mats small { display: block; margin-top: 6px; font-size: 13px; color: var(--ink-3); }
@media (max-width: 900px) { .mats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.uses { --cols: 4; --mcol: 72%; }
.uses div { padding: 22px; border-radius: var(--r-lg); min-height: 170px; display: flex; flex-direction: column; justify-content: space-between; gap: 18px; }
.uses b { font: 700 20px/1.15 var(--font-display); font-stretch: 108%; }
.uses span { color: var(--ink-2); font-size: 14px; }
.uses em { font: 500 12px/1 var(--font-mono); font-style: normal; color: var(--acc-text); }
@media (max-width: 1000px) { .uses { --cols: 2; } }
/* gallery */
.gal { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(150px, 15vw, 220px); grid-auto-flow: dense; gap: 12px; }
.gal button { position: relative; border-radius: 18px; overflow: hidden; border: 1px solid var(--stroke); cursor: zoom-in; }
.gal button:nth-child(7n+1) { grid-column: span 2; grid-row: span 2; }
.gal button:nth-child(7n+5) { grid-row: span 2; }
.gal .ph { position: absolute; inset: 0; }
.gal button:hover .ph img { transform: scale(1.06); }
.gal button span.c { position: absolute; z-index: 2; left: 10px; bottom: 10px; padding: 6px 9px; border-radius: 9px; font-size: 12px; color: #fff; background: oklch(15% .02 158 / .5); opacity: 0; transform: translateY(6px); transition: opacity var(--dur-2), transform var(--dur-3) var(--ease-out); }
.gal button:hover span.c { opacity: 1; transform: none; }
@media (max-width: 760px) {
  .gal { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 78%; grid-auto-rows: 220px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px var(--gut) 20px; margin-inline: calc(var(--gut) * -1); scrollbar-width: none; }
  .gal::-webkit-scrollbar { display: none; } .gal button { scroll-snap-align: start; grid-column: auto !important; grid-row: auto !important; }
}
/* plans */
.pl { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, .8fr); gap: clamp(16px, 2.4vw, 28px); align-items: start; }
.pl .pvw { padding: 8px; border-radius: var(--r-xl); }
.pl-side { display: grid; gap: var(--space-md); }
.ptabs { display: grid; gap: 6px; }
.ptabs button { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 13px 16px; border-radius: 14px; text-align: left; background: var(--glass); border: 1px solid var(--stroke); transition: background-color var(--dur-2), border-color var(--dur-2), color var(--dur-2); }
.ptabs button b { font: 700 15px/1.2 var(--font-display); font-stretch: 108%; }
.ptabs button small { display: block; font-size: 12.5px; color: var(--ink-3); margin-top: 3px; }
.ptabs button span.a { font: 500 12px/1 var(--font-mono); color: var(--acc-text); white-space: nowrap; }
.ptabs button[aria-selected="true"] { background: var(--btn-ink); color: var(--btn-on-ink); border-color: var(--btn-ink); }
.ptabs button[aria-selected="true"] small, .ptabs button[aria-selected="true"] span.a { color: inherit; opacity: .7; }
.ptabs.scroll { max-height: 520px; overflow: auto; padding-right: 4px; }
@media (max-width: 900px) { .pl { grid-template-columns: minmax(0, 1fr); } .ptabs { grid-auto-flow: column; grid-auto-columns: minmax(170px, 46%); overflow-x: auto; max-height: none !important; scrollbar-width: none; } }
.sizes { padding: clamp(20px, 2.6vw, 30px); border-radius: var(--r-lg); }
/* payment */
.pay { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 0; padding: 0; overflow: hidden; border-radius: var(--r-xl); }
.pay-in { padding: clamp(24px, 3vw, 40px); display: grid; gap: var(--space-lg); align-content: start; border-right: 1px solid var(--stroke); }
.pay-out { padding: clamp(24px, 3vw, 40px); display: grid; gap: var(--space-lg); align-content: start; }
.kpis { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 10px; }
.kpi { padding: 18px; border-radius: 18px; background: var(--glass); border: 1px solid var(--stroke); min-width: 0; }
.kpi small { display: block; font-size: 12.5px; color: var(--ink-3); }
.kpi b { display: block; margin-top: 8px; font: 800 clamp(22px, 2.3vw, 32px)/1.05 var(--font-display); font-stretch: 108%; letter-spacing: -.02em; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.kpi em { display: block; margin-top: 6px; font: 500 12px/1.3 var(--font-mono); font-style: normal; color: var(--acc-text); }
.kpi.big { grid-column: 1 / -1; background: linear-gradient(160deg, var(--green), var(--green-2)); color: var(--green-ink); border-color: transparent; }
.kpi.big small { color: oklch(95% .02 90 / .7); }
.kpi.big b { font-size: clamp(30px, 3.6vw, 48px); color: oklch(88% .09 86); }
.split-bar { display: flex; height: 14px; border-radius: 14px; overflow: hidden; background: var(--glass-2); }
.split-bar i { display: block; height: 100%; transition: flex-basis .8s var(--ease-out); }
.split-bar i:nth-child(1) { background: var(--acc-hi); } .split-bar i:nth-child(2) { background: var(--acc-lo); } .split-bar i:nth-child(3) { background: oklch(60% .1 150); }
.legend { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 13px; color: var(--ink-2); }
.legend span { display: inline-flex; align-items: center; gap: 8px; }
.legend i { width: 10px; height: 10px; border-radius: 3px; }
.rng { width: 100%; accent-color: var(--acc); height: 28px; }
.money { position: relative; }
.money span { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: var(--ink-3); font-size: 14px; pointer-events: none; }
.money .inp { padding-left: 46px; font-variant-numeric: tabular-nums; }
.tog { display: flex; align-items: center; gap: 12px; cursor: pointer; font-size: 14.5px; }
.tog input { appearance: none; width: 46px; height: 26px; border-radius: 26px; background: var(--glass-3); border: 1px solid var(--stroke-2); position: relative; transition: background-color var(--dur-2); cursor: pointer; flex: none; }
.tog input::after { content: ""; position: absolute; left: 3px; top: 3px; width: 18px; height: 18px; border-radius: 50%; background: var(--ink); transition: transform var(--dur-3) var(--ease-out); }
.tog input:checked { background: var(--acc); } .tog input:checked::after { transform: translateX(20px); background: var(--on-acc); }
.rates { display: grid; gap: 6px; }
.rates button { display: grid; grid-template-columns: 74px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 8px 10px; border-radius: 12px; border: 1px solid transparent; text-align: left; transition: background-color var(--dur-2), border-color var(--dur-2); }
.rates button:hover { background: var(--glass); }
.rates button[aria-pressed="true"] { background: var(--glass-2); border-color: var(--stroke-2); }
.rates b { font: 600 13.5px/1.2 var(--font-body); }
.rates .bar-t { height: 8px; }
.rates .v { font: 500 13px/1 var(--font-mono); font-variant-numeric: tabular-nums; }
.fine { font-size: 12.5px; color: var(--ink-3); line-height: 1.5; }
@media (max-width: 900px) { .pay { grid-template-columns: minmax(0, 1fr); } .pay-in { border-right: 0; border-bottom: 1px solid var(--stroke); } }
/* videos */
.vids { --cols: 3; --mcol: 86%; }
/* timeline */
.tl { position: relative; display: grid; gap: 0; padding-left: 28px; }
.tl::before { content: ""; position: absolute; left: 7px; top: 6px; bottom: 6px; width: 1px; background: linear-gradient(var(--acc), var(--stroke)); }
.tl > div { position: relative; padding: 0 0 28px; }
.tl > div::before { content: ""; position: absolute; left: -26px; top: 5px; width: 13px; height: 13px; border-radius: 50%; background: var(--bg); border: 2px solid var(--acc); }
.tl > div:first-child::before { background: var(--acc); box-shadow: 0 0 0 5px var(--acc-soft); }
.tl small { font: 500 12px/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--acc-text); }
.tl b { display: block; margin-top: 8px; font: 700 20px/1.2 var(--font-display); font-stretch: 108%; }
.tl p { margin-top: 6px; color: var(--ink-2); max-width: 56ch; }
.upd { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
@media (max-width: 900px) { .upd { grid-template-columns: minmax(0, 1fr); } }
/* map */
.mloc { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, .8fr); gap: 16px; align-items: stretch; }
.mloc .near { padding: clamp(20px, 2.6vw, 30px); border-radius: var(--r-xl); }
.mloc .near li { display: flex; justify-content: space-between; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--stroke); font-size: 14.5px; list-style: none; }
.mloc .near li span { font: 500 12.5px/1.4 var(--font-mono); color: var(--acc-text); white-space: nowrap; }
@media (max-width: 900px) { .mloc { grid-template-columns: minmax(0, 1fr); } }
/* tour */
.tour { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(20px, 4vw, 56px); padding: clamp(24px, 4vw, 52px); }
.tour .tim { position: relative; z-index: 1; aspect-ratio: 1122 / 1402; max-height: 520px; justify-self: center; border-radius: var(--r-lg); overflow: hidden; width: 100%; max-width: 420px; }
.tour .tim .ph { position: absolute; inset: 0; }
.tour > div { position: relative; z-index: 1; }
@media (max-width: 860px) { .tour { grid-template-columns: minmax(0, 1fr); } }
/* enquiry */
.penq { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(24px, 4vw, 56px); padding: clamp(26px, 4vw, 52px); border-radius: var(--r-xl); align-items: start; }
.penq form { display: grid; gap: var(--space-md); }
@media (max-width: 900px) { .penq { grid-template-columns: minmax(0, 1fr); } }
.pn { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; margin-top: var(--space-xl); }
.pn a { padding: 20px 22px; border-radius: var(--r-lg); display: grid; gap: 4px; }
.pn a:last-child { text-align: right; }

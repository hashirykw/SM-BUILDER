.pn b { font: 700 18px/1.2 var(--font-display); font-stretch: 108%; }
.rel-h { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-lg); margin-bottom: var(--space-lg); }
.nf { padding: 60px 24px; text-align: center; border-radius: var(--r-xl); }

===JS===
SM.boot(function(){
  const {$, $$, esc, D, img, I} = SM;
  SM.stage($('#astage'), { dur: 1800, delay: 300, fit: .92, max: 340 });
  $('.story-img').innerHTML = img(D.pic('2024/01/About_us_page.jpg'), 'S. M. Builders & Developers, affiliated and enlisted with ABAD, KCCI, PEC and others').replace('class="ph ', 'class="ph ');
  $('.story-img .ph').style.cssText = 'aspect-ratio:570/640;background:#fff';
  $('.ti').innerHTML = SM.rawImg(D.pic('2021/09/Our-Team-1024x217.png'), 'Project team: Arch Vision Plus, ECC MEP consultancy, structural engineers, visualisers and Design & Depth interiors');
  $('#what').innerHTML = ['Surveying', 'Consulting', 'Property development', 'Marketing & selling', 'Maintenance'].map((w, i) => `<div class="glass rv d${i % 4}" data-spot><em>0${i + 1}</em><b>${w}</b></div>`).join('');
  const T = [
    ['1967', 'S. M. Group begins its journey', 'A family enterprise in Karachi, founded on experiential design, novelty and commitment.'],
    ['Decades', 'Homes, halls and schools', 'Residential complexes, banquet halls such as Bella Vista, and educational institutions including SM Public Academy, now 50 years in education.'],
    ['2023', 'Burj Al Jinnah rises', 'Two floors a month on Main Jinnah Avenue; deals signed with Agha Steel, D.G. Khan Cement, Envicrete, Pakistan Cables and Grohe.'],
    ['2024', 'Completion certificate & S. M. House', 'The elevation of Burj Al Jinnah is finalized and its completion certificate acquired. S. M. House launches at Main 5 Star, North Nazimabad.'],
    ['2025', 'S. M. Axis launches', 'A Ground + 22 tower of 83 three-bed apartments on Sher Shah Suri Road opens for booking.'],
    ['2026', 'Recognition & milestones', 'Honoured as an early leader in EV-enabled communities; S. M. House completes its 7th floor slab in 15 months; Burj Al Jinnah enters its final phase.'],
    ['2027', 'S. M. House possession', 'Published target for possession of S. M. House, May 2027.', 'up']
  ];
  $('#time').innerHTML = T.map(t => `<div class="time-row rv ${t[3] || ''}"><span class="y">${t[0]}</span><span class="ax"></span><div class="tx"><b>${esc(t[1])}</b><p>${esc(t[2])}</p></div></div>`).join('');
  $('#ven').innerHTML = D.VEN.map(v => `<div class="ltile rv"><span class="lim${/logos-0[14]/.test(v.src) ? ' dk' : ''}">${SM.rawImg(v, v.n)}</span><span><b>${esc(v.n)}</b><small>${esc(v.t)}</small></span></div>`).join('');
  $('#aff').innerHTML = D.AFF.map(a => `<div class="ltile rv"><span class="lim">${SM.rawImg(a, a.full)}</span><span><b>${esc(a.n)}</b><small>${esc(a.full)}</small></span></div>`).join('');
  $('#dls').innerHTML = [['Company brochure', 'S. M. Builders & Developers, PDF', D.C.files.brochure], ['Burj Al Jinnah tri-fold', 'Project leaflet, PDF', D.C.files.trifold], ['S. M. Group profile', 'Company profile 2026, PDF', D.C.files.profile]]
    .map(d => `<a class="dl glass rv" href="${d[2]}" target="_blank" rel="noopener" data-spot><span class="di">${I.down}</span><span><b>${esc(d[0])}</b><small>${esc(d[1])}</small></span></a>`).join('');
  SM.observe();
});
